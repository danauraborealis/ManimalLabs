<Project>
  <!-- single source of truth for version + identity, per manimal mod conventions -->
  <PropertyGroup>
    <ModVersion>2.0.0</ModVersion>
    <ModGuid>com.manimal.labsboiler</ModGuid>
    <ModUsername>Manimal</ModUsername>
    <ModDisplayName>LabsBoiler</ModDisplayName>
    <SPTPath>D:\SPT41Dev</SPTPath>
    <!-- Override on the command line for a separate Fika install. Leaving this
         empty prevents a 4.1 build from being copied into the old 4.0 install. -->
    <FikaPath></FikaPath>
  </PropertyGroup>
</Project>
